@page "/"
@rendermode InteractiveServer

<PageTitle>To-Do List - App 03</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark">To-Do List</h2>
                <p class="text-muted">@tasks.Count task@(tasks.Count == 1 ? "" : "s") in your list</p>
            </div>
            <div class="card border-0 shadow" style="border-radius:16px;">
                <div class="card-header py-3 px-4 text-white fw-bold" style="background:#059669; border-radius:16px 16px 0 0;">
                    My Tasks
                </div>
                <div class="card-body p-4">
                    <div class="input-group mb-4">
                        <input @bind="newTask" @bind:event="oninput" @onkeydown="HandleKeyDown"
                               class="form-control form-control-lg"
                               placeholder="Type a task and press Enter..." />
                        <button class="btn text-white fw-bold px-4"
                                style="background:#059669; border:none;"
                                @onclick="AddTask"
                                disabled="@(string.IsNullOrWhiteSpace(newTask))">
                            + Add
                        </button>
                    </div>
                    @if (tasks.Count == 0)
                    {
                        <div class="text-center py-4">
                            <div style="font-size:2.5rem;">📝</div>
                            <p class="mt-2 mb-0 text-muted">No tasks yet. Add one above!</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var (task, index) in tasks.Select((t, i) => (t, i)))
                            {
                                <li class="list-group-item px-0 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="checkbox" class="form-check-input mt-0"
                                               style="width:18px;height:18px;"
                                               @bind="tasks[index].IsCompleted" />
                                        <span class="text-dark @(tasks[index].IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                            @task.Text
                                        </span>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                            @onclick="() => RemoveTask(index)">Delete</button>
                                </li>
                            }
                        </ul>
                        <div class="d-flex gap-2">
                            <button class="btn btn-danger flex-fill rounded-pill fw-semibold" @onclick="ClearAll">Clear All</button>
                            <button class="btn btn-outline-secondary flex-fill rounded-pill fw-semibold"
                                    @onclick="ClearCompleted"
                                    disabled="@(!tasks.Any(t => t.IsCompleted))">Clear Completed</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string newTask = "";
    private List<TodoItem> tasks = new();
    private void AddTask() { if (!string.IsNullOrWhiteSpace(newTask)) { tasks.Add(new TodoItem { Text = newTask.Trim() }); newTask = ""; } }
    private void RemoveTask(int index) { if (index >= 0 && index < tasks.Count) tasks.RemoveAt(index); }
    private void ClearAll() => tasks.Clear();
    private void ClearCompleted() => tasks.RemoveAll(t => t.IsCompleted);
    private void HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") AddTask(); }
    public class TodoItem { public string Text { get; set; } = ""; public bool IsCompleted { get; set; } = false; }
}
